{
  "name": "jb-color-input",
  "version": "0.2.0",
  "description": "CSS color input and picker web component",
  "type": "module",
  "author": {
    "name": "mohammad javad bathaei",
    "email": "javadbat@gmail.com"
  },
  "license": "MIT",
  "keywords": [
    "jb",
    "color",
    "color input",
    "color picker",
    "rgb",
    "oklch",
    "web component",
    "react",
    "typescript"
  ],
  "files": [
    "LICENSE",
    "README.md",
    "web-component/custom-elements.json",
    "web-component/lib/",
    "web-component/dist/",
    "react/",
    "react/dist/"
  ],
  "main": "index.js",
  "types": "./web-component/dist/jb-color-input.d.ts",
