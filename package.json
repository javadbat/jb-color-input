      "types": "./react/dist/JBColorInput.d.ts",
      "default": "./react/index.js"
    },
    "./*": "./*"
  },
  "customElements": "web-component/custom-elements.json",
  "repository": {
    "type": "git",
    "url": "https://github.com/javadbat/jb-color-input.git"
  },
  "bugs": "https://github.com/javadbat/jb-color-input/issues",
  "homepage": "https://javadbat.github.io/design-system/?path=/docs/components-form-elements-inputs-jbcolorinput",
  "dependencies": {
    "jb-color-picker": "^0.2.0",
    "jb-core": "^0.36.0",
    "jb-input": "^3.19.0",
    "jb-popover": "^1.15.2",
    "jb-validation": "^1.0.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "tslib": "^2.8.1"
  }
}
